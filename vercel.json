{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": null,
  "framework": null,
  "redirects": [
    { "source": "/taxnav", "destination": "/taxswipe", "permanent": true },
    { "source": "/taxnav/privacy", "destination": "/taxswipe/privacy", "permanent": true },
